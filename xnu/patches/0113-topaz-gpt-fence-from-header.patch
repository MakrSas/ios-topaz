From 4e80133e2db66ee04e46d83d17f912a1f87893b7 Mon Sep 17 00:00:00 2001
From: Taurind14 <huqsakamara@gmail.com>
Date: Mon, 19 Oct 2026 19:33:09 +0700
Subject: [PATCH] topaz-0113: GPT write fence derived from the GPT header;
 watchdog also compares the backup entry-array CRC

---
 bsd/dev/sweet_ufs.c | 47 +++++++++++++++++++++++++++++++++++++--------
 1 file changed, 39 insertions(+), 8 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 467ce46..4412b06 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -277,8 +277,18 @@ ufs_read_blocks(uint64_t lba, uint32_t count)
  * a watchdog thread re-reads them and panics the moment they change.
  */
 static uint64_t gpt_alt;                /* backup header LBA (last LBA of LUN0) */
-static uint32_t gpt_hcrc, gpt_ecrc, gpt_bhcrc;
+static uint32_t gpt_hcrc, gpt_ecrc, gpt_bhcrc, gpt_becrc;
 static int gpt_chan;
+/*
+ * topaz 0113: the fenced spans are derived from the GPT header itself
+ * (PartitionEntryLBA + NumberOfPartitionEntries * SizeOfPartitionEntry,
+ * in 4 KiB device blocks) instead of the usual 128-entry layout that the
+ * constants 6 and 4 of patch 0088 assumed. The defaults below are that
+ * layout, so the fence is never weaker than 0088 before the header is
+ * parsed (and a header with more entries widens it, never narrows it).
+ */
+static uint64_t gpt_lo_end = 6;         /* first LBA after the primary GPT */
+static uint64_t gpt_hi_start;           /* first LBA of the backup GPT; 0 = unknown */
 
 /*
  * WRITE(10) of count device blocks from the bounce buffer to lba. The range
@@ -290,7 +300,7 @@ ufs_write_blocks(uint64_t lba, uint32_t count)
 	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
 	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
 	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX ||
-	    lba < 6 || (gpt_alt && lba + count - 1 >= gpt_alt - 4)) {
+	    lba < gpt_lo_end || (gpt_hi_start && lba + count - 1 >= gpt_hi_start)) {
 		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
 		return EPERM;
 	}
@@ -333,6 +343,19 @@ ufs_find_partition(const char *want)
 		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
 		return ENXIO;
 	}
+	/*
+	 * topaz 0113: fence exactly the blocks both GPT copies occupy. The
+	 * primary entries start at entry_lba; the backup entries end at the
+	 * backup header (gpt_alt), whose own entry LBA (read below, once the
+	 * wanted partition is found) is the authoritative backup span start.
+	 */
+	uint64_t entry_blocks = (nent * (uint64_t)esz + UFS_BLOCK - 1) / UFS_BLOCK;
+	if (entry_lba >= 2 && entry_lba + entry_blocks > gpt_lo_end) {
+		gpt_lo_end = entry_lba + entry_blocks;
+	}
+	if (gpt_alt > entry_blocks) {
+		gpt_hi_start = gpt_alt - entry_blocks;
+	}
 	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
 	if (error) {
 		return error;
@@ -361,10 +384,16 @@ ufs_find_partition(const char *want)
 		su.first_block = first;
 		su.nblocks = last - first + 1;
 		if (ufs_read_blocks(gpt_alt, 1) == 0 && memcmp(b, "EFI PART", 8) == 0) {
+			uint64_t bentry_lba;
 			memcpy(&gpt_bhcrc, b + 16, 4);
+			memcpy(&gpt_becrc, b + 88, 4);
+			memcpy(&bentry_lba, b + 72, 8);
+			if (bentry_lba > 0 && bentry_lba < gpt_alt) {
+				gpt_hi_start = bentry_lba;
+			}
 		}
-		printf("SWEET UFS: GPT LUN0 hcrc %#x ecrc %#x backup@%#llx hcrc %#x\n",
-		    gpt_hcrc, gpt_ecrc, gpt_alt, gpt_bhcrc);
+		printf("SWEET UFS: GPT LUN0 hcrc %#x ecrc %#x backup@%#llx hcrc %#x becrc %#x fence <%#llx >=%#llx\n",
+		    gpt_hcrc, gpt_ecrc, gpt_alt, gpt_bhcrc, gpt_becrc, gpt_lo_end, gpt_hi_start);
 		return 0;
 	}
 	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
@@ -612,7 +641,7 @@ sweet_gpt_watch(__unused void *arg, __unused wait_result_t wr)
 		(void)assert_wait_deadline(&gpt_chan, THREAD_UNINT, deadline);
 		thread_block(THREAD_CONTINUE_NULL);
 
-		uint32_t h = 0, e = 0, bh = 0;
+		uint32_t h = 0, e = 0, bh = 0, be = 0;
 		bool ok;
 		lck_mtx_lock(&sweet_ufs_lock);
 		ok = ufs_read_blocks(1, 1) == 0 && memcmp(b, "EFI PART", 8) == 0;
@@ -623,14 +652,16 @@ sweet_gpt_watch(__unused void *arg, __unused wait_result_t wr)
 		if (ok && gpt_bhcrc && ufs_read_blocks(gpt_alt, 1) == 0) {
 			if (memcmp(b, "EFI PART", 8) == 0) {
 				memcpy(&bh, b + 16, 4);
+				memcpy(&be, b + 88, 4);
 			}
 		}
 		lck_mtx_unlock(&sweet_ufs_lock);
-		if (!ok || h != gpt_hcrc || e != gpt_ecrc || (gpt_bhcrc && bh != gpt_bhcrc)) {
+		if (!ok || h != gpt_hcrc || e != gpt_ecrc || (gpt_bhcrc && bh != gpt_bhcrc) ||
+		    (gpt_becrc && be != gpt_becrc)) {
 			uint64_t ns;
 			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
-			panic("SWEET UFS: GPT LUN0 CHANGED after %llu s: primary %s hcrc %#x/%#x ecrc %#x/%#x backup hcrc %#x/%#x",
-			    ns / NSEC_PER_SEC, ok ? "present" : "MISSING", h, gpt_hcrc, e, gpt_ecrc, bh, gpt_bhcrc);
+			panic("SWEET UFS: GPT LUN0 CHANGED after %llu s: primary %s hcrc %#x/%#x ecrc %#x/%#x backup hcrc %#x/%#x becrc %#x/%#x",
+			    ns / NSEC_PER_SEC, ok ? "present" : "MISSING", h, gpt_hcrc, e, gpt_ecrc, bh, gpt_bhcrc, be, gpt_becrc);
 		}
 	}
 }
-- 
