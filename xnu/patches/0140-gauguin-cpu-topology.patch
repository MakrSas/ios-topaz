-	 */
-	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0x100) {
-		panic("SWEET CPU: expected boot MPIDR 0x100 and logical CPU 0, got 0x%x/%u",
+	/* Gauguin shim boots on MPIDR 0; this core reports TGran16 support. */
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
+		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0, got 0x%x/%u",
 		    topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
 	}
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -18,11 +18,10 @@
 #define SWEET                     1
 
 /*
- * All eight cores as one homogeneous SMP cluster (topaz: four A53 at
- * MPIDR 0x0-0x3 + four A73 at 0x100-0x103; sweet: six A55 + two A76):
- * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
- * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
- * clusters yet).
+ * Gauguin (SM7225): six efficiency cores and two performance cores; MPIDR
+ * values are expected in the 0x000-0x500 and 0x600-0x700 ranges.
+ * cpus=N is clamped here. ARMv8.2 baseline, 64-byte lines, and PSCI CPU_ON;
+ * heterogeneous core scheduling is not modeled yet.
  */
 #define SWEET_SMP_MAX_CPUS         8
 
