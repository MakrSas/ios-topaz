From 9540e1ebd00b370eb4d4fcd02ae18135da4ac8b1 Mon Sep 17 00:00:00 2001
From: Taurind14 <huqsakamara@gmail.com>
Date: Mon, 19 Oct 2026 20:01:27 +0700
Subject: [PATCH] topaz-0114: touch: release all contacts on TD_STATUS 0 frames

---
 bsd/dev/sweet_touch.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index ff9d858..370d18b 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -490,11 +490,15 @@ touch_focaltech(void)
 	if (n > st.s_maxn) {
 		st.s_maxn = n;
 	}
-	if (n > TOUCH_MAX && buf[3] == 0xffu) {
+	if (n == 0 || (n > TOUCH_MAX && buf[3] == 0xffu)) {
 		/*
-		 * topaz: with no contact the FT5452 (firmware as updated by HyperOS
-		 * 2.0.208) reports TD_STATUS 0xff and 0xff records. TopazTouch: a count
-		 * of 0 or > 10 means "release all", not an error.
+		 * topaz: an empty report releases every contact, like Linux
+		 * focaltech and TopazTouch. With no contact the FT5452 (firmware
+		 * as updated by HyperOS 2.0.208) reports TD_STATUS 0xff and 0xff
+		 * records; TD_STATUS 0 must not be parsed as slots either: its
+		 * records can carry a stale contact slot that resurrects a lifted
+		 * finger (TopazTouch v0.13 fixed exactly that stuck-finger case),
+		 * and an all-zero frame would become a phantom finger 0 at (0,0).
 		 */
 		touch_report(0, x, y);
 		return 0;
-- 
