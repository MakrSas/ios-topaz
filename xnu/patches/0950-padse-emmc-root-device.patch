diff --git a/bsd/dev/sweet_emmc.c b/bsd/dev/sweet_emmc.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_emmc.c
@@ -0,0 +1,737 @@
+/*
+ * SWEET internal eMMC root device (read-only) for the Redmi Pad SE (xun).
+ *
+ * The Qualcomm SDHCI host (sdhci@4744000, SDHCI 3.00 register layout) is left
+ * idle by the bootloader (internal clock running, SD clock off, no power bit).
+ * This driver resets the host, starts the card clock at about 400 kHz, takes the
+ * eMMC through the standard bring-up (CMD0, CMD1, CMD2, CMD3, CMD7), moves it to
+ * an 8-bit bus and the HS timing, and then reads with polled ADMA2 DMA (CMD18 with
+ * auto CMD12), one command at a time, into one physically contiguous bounce buffer.
+ * The sequence was proven on the tablet by shim/sdhci.c.
+ *
+ * It finds one GPT partition by name (boot-arg emmcroot=, default "userdata")
+ * and exposes it as the BSD disk emmcroot0 (remmcroot0), 512-byte sectors.
+ * Root on it with rd=emmcroot0.
+ *
+ * Commands that can ever be sent: CMD0/1/2/3/7 (bring-up), CMD6 restricted to
+ * the volatile EXT_CSD bytes BUS_WIDTH and HS_TIMING, CMD12, CMD13 and CMD18.
+ * There is no write command: writes are refused.
+ *
+ * The host is not cache coherent: caches are cleaned/invalidated around DMA.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* Standard SDHCI registers */
+#define E_BLK           0x04    /* 32-bit: [15:0] block size, [31:16] block count */
+#define E_ARG           0x08
+#define E_CMDMODE       0x0c    /* 32-bit: [15:0] transfer mode, [31:16] command */
+#define E_RESP0         0x10
+#define E_PRESENT       0x24
+#define E_HOSTCTL       0x28    /* 8-bit */
+#define E_PWR           0x29    /* 8-bit */
+#define E_CLK           0x2c    /* 16-bit */
+#define E_TOUT          0x2e    /* 8-bit */
+#define E_SWRST         0x2f    /* 8-bit */
+#define E_NINT          0x30    /* 16-bit normal interrupt status */
+#define E_EINT          0x32    /* 16-bit error interrupt status */
+#define E_NINT_EN       0x34
+#define E_EINT_EN       0x36
+#define E_NINT_SIG      0x38
+#define E_EINT_SIG      0x3a
+#define E_ADMA_ERR      0x54
+#define E_ADMA_ADDR     0x58    /* 64-bit */
+#define E_VERSION       0xfe    /* 16-bit */
+
+#define PS_CMD_INH      (1u << 0)
+#define PS_DAT_INH      (1u << 1)
+#define NI_CMD_DONE     (1u << 0)
+#define NI_XFER_DONE    (1u << 1)
+#define NI_ERR          (1u << 15)
+
+/* command register: index << 8 | flags */
+#define CMDF_R1         0x1a    /* 48-bit response, CRC and index check */
+#define CMDF_R1B        0x1b    /* the same, with busy */
+#define CMDF_R2         0x09    /* 136-bit response, CRC check */
+#define CMDF_R3         0x02    /* 48-bit response, no checks (OCR) */
+#define CMDF_DATA       0x20
+
+#define EBLOCK          512u
+#define BOUNCE_SIZE     (256u << 10)
+#define ADMA_CHUNK      (32u << 10)             /* one descriptor, well under the 16-bit length */
+#define ADMA_MAX        (BOUNCE_SIZE / ADMA_CHUNK)
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_ADMA        0x0000                  /* descriptor table, 8 byte aligned */
+#define DMA_BOUNCE      0x1000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+#define MS_NS           (1000ull * 1000)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint64_t first_block, nblocks;          /* partition, in 512-byte sectors */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	uint32_t resp[4];                       /* last command response */
+	uint32_t nint, eint;                    /* status of the last failure */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} se;
+
+static LCK_GRP_DECLARE(sweet_emmc_grp, "sweet_emmc");
+static LCK_MTX_DECLARE(sweet_emmc_lock, &sweet_emmc_grp);
+
+static inline uint8_t
+e_rd8(uint32_t off)
+{
+	return *(volatile uint8_t *)(se.regs + off);
+}
+
+static inline uint16_t
+e_rd16(uint32_t off)
+{
+	return *(volatile uint16_t *)(se.regs + off);
+}
+
+static inline uint32_t
+e_rd32(uint32_t off)
+{
+	return *(volatile uint32_t *)(se.regs + off);
+}
+
+static inline void
+e_wr8(uint32_t off, uint8_t v)
+{
+	*(volatile uint8_t *)(se.regs + off) = v;
+}
+
+static inline void
+e_wr16(uint32_t off, uint16_t v)
+{
+	*(volatile uint16_t *)(se.regs + off) = v;
+}
+
+static inline void
+e_wr32(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(se.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(se.dma_pa + off), len, TRUE);
+}
+
+static uint64_t
+e_deadline(uint64_t ns)
+{
+	uint64_t d;
+
+	nanoseconds_to_absolutetime(ns, &d);
+	return d + mach_absolute_time();
+}
+
+/* Wait until none of the bits in mask are set in the present-state register. */
+static int
+e_wait_idle(uint32_t mask, uint64_t ns)
+{
+	uint64_t dl = e_deadline(ns);
+
+	while (e_rd32(E_PRESENT) & mask) {
+		if (mach_absolute_time() > dl) {
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+/* Wait for any of bits (or the error flag) in the normal interrupt status. */
+static int
+e_wait_nint(uint16_t bits, uint64_t ns)
+{
+	uint64_t dl = e_deadline(ns);
+
+	for (;;) {
+		uint16_t s = e_rd16(E_NINT);
+		if (s & NI_ERR) {
+			se.nint = s;
+			se.eint = e_rd16(E_EINT);
+			return EIO;
+		}
+		if (s & bits) {
+			return 0;
+		}
+		if (mach_absolute_time() > dl) {
+			se.nint = s;
+			se.eint = e_rd16(E_EINT);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+}
+
+/* Clear status and reset the CMD and DAT lines. */
+static void
+e_reset_lines(void)
+{
+	uint64_t dl = e_deadline(10 * MS_NS);
+
+	e_wr32(E_NINT, 0xffffffff);
+	e_wr8(E_SWRST, 0x06);
+	while ((e_rd8(E_SWRST) & 0x06) && mach_absolute_time() <= dl) {
+		delay(1);
+	}
+}
+
+/*
+ * One command without a data phase. Allowed: CMD0/1/2/3/7, CMD6 (through
+ * e_switch only), CMD12, CMD13. flags: response type and checks (CMDF_*).
+ */
+static int
+e_cmd(uint32_t index, uint32_t arg, uint32_t flags)
+{
+	int error;
+
+	if (index != 0 && index != 1 && index != 2 && index != 3 && index != 6 &&
+	    index != 7 && index != 12 && index != 13) {
+		return EINVAL;
+	}
+	error = e_wait_idle(PS_CMD_INH, 100 * MS_NS);
+	if (!error && (flags & 3) == 3) {
+		error = e_wait_idle(PS_DAT_INH, 100 * MS_NS);
+	}
+	if (error) {
+		return error;
+	}
+	e_wr32(E_NINT, 0xffffffff);
+	e_wr32(E_ARG, arg);
+	e_wr32(E_CMDMODE, ((index << 8) | flags) << 16);
+	error = e_wait_nint(NI_CMD_DONE, 300 * MS_NS);
+	if (!error) {
+		for (int i = 0; i < 4; i++) {
+			se.resp[i] = e_rd32(E_RESP0 + 4 * i);
+		}
+		e_wr16(E_NINT, NI_CMD_DONE);
+		if ((flags & 3) == 3) {         /* busy after the response */
+			error = e_wait_nint(NI_XFER_DONE, 500 * MS_NS);
+			if (!error) {
+				e_wr16(E_NINT, NI_XFER_DONE);
+			}
+		}
+	}
+	if (error) {
+		e_reset_lines();
+	}
+	return error;
+}
+
+/* CMD6 on the two volatile EXT_CSD bytes we may change. */
+static int
+e_switch(uint32_t index, uint32_t value)
+{
+	if (!((index == 183 && value <= 2) || (index == 185 && value <= 1))) {
+		return EINVAL;
+	}
+	return e_cmd(6, (3u << 24) | (index << 16) | (value << 8) | 1, CMDF_R1B);
+}
+
+/* CMD13: bit 7 of the card status is SWITCH_ERROR. */
+static int
+e_status_ok(void)
+{
+	int error = e_cmd(13, 1u << 16, CMDF_R1);
+
+	if (error) {
+		return error;
+	}
+	return (se.resp[0] & (1u << 7)) ? EIO : 0;
+}
+
+/* SDCLK = base / (2 * n) (programmable clock mode). */
+static int
+e_set_clock(uint32_t n)
+{
+	uint64_t dl = e_deadline(50 * MS_NS);
+
+	e_wr16(E_CLK, e_rd16(E_CLK) & ~4);      /* SD clock off while changing */
+	e_wr16(E_CLK, (uint16_t)(((n & 0xff) << 8) | (((n >> 8) & 3) << 6) | 1));
+	while (!(e_rd16(E_CLK) & 2)) {          /* internal clock stable */
+		if (mach_absolute_time() > dl) {
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	e_wr16(E_CLK, e_rd16(E_CLK) | 4);       /* SD clock on */
+	delay(2000);
+	return 0;
+}
+
+static int
+e_bringup(void)
+{
+	int error;
+	uint64_t dl = e_deadline(100 * MS_NS);
+	uint16_t ver = e_rd16(E_VERSION);
+
+	if (ver == 0 || ver == 0xffff) {
+		printf("SWEET EMMC: no SDHCI host (version 0x%x)\n", ver);
+		return ENXIO;
+	}
+	e_wr8(E_SWRST, 0x01);                   /* software reset for all */
+	while (e_rd8(E_SWRST) & 1) {
+		if (mach_absolute_time() > dl) {
+			printf("SWEET EMMC: host reset did not finish\n");
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	e_wr8(E_PWR, 0x0f);                     /* 3.3 V, bus power on */
+	e_wr8(E_TOUT, 0x0e);                    /* data timeout: maximum */
+	e_wr8(E_HOSTCTL, 0x00);                 /* 1-bit bus, normal speed */
+	e_wr16(E_NINT_SIG, 0);                  /* polled operation */
+	e_wr16(E_EINT_SIG, 0);
+	error = e_set_clock(250);               /* base / 500: about 400 kHz */
+	if (error) {
+		printf("SWEET EMMC: internal clock never stable\n");
+		return error;
+	}
+	e_wr16(E_NINT_EN, NI_CMD_DONE | NI_XFER_DONE);
+	e_wr16(E_EINT_EN, 0xffff);
+	delay(5000);
+
+	if ((error = e_cmd(0, 0, 0x00))) {
+		printf("SWEET EMMC: CMD0 failed: %d\n", error);
+		return error;
+	}
+	delay(2000);
+	dl = e_deadline(1000 * MS_NS);
+	for (;;) {
+		error = e_cmd(1, 0x40ff8080, CMDF_R3);
+		if (error) {
+			printf("SWEET EMMC: CMD1 failed: %d\n", error);
+			return error;
+		}
+		if (se.resp[0] & 0x80000000u) {
+			break;
+		}
+		if (mach_absolute_time() > dl) {
+			printf("SWEET EMMC: card stays busy, ocr 0x%x\n", se.resp[0]);
+			return ETIMEDOUT;
+		}
+		delay(2000);
+	}
+	printf("SWEET EMMC: ocr 0x%x\n", se.resp[0]);
+	if ((error = e_cmd(2, 0, CMDF_R2)) ||
+	    (error = e_cmd(3, 1u << 16, CMDF_R1)) ||
+	    (error = e_cmd(7, 1u << 16, CMDF_R1B))) {
+		printf("SWEET EMMC: card select failed: %d\n", error);
+		return error;
+	}
+
+	/* 8-bit bus: switch the card at the slow clock, then the host, then speed up. */
+	if ((error = e_switch(183, 2))) {
+		printf("SWEET EMMC: bus width switch failed: %d\n", error);
+		return error;
+	}
+	e_wr8(E_HOSTCTL, 0x20);
+	if ((error = e_set_clock(4)) || (error = e_status_ok())) {
+		printf("SWEET EMMC: 8-bit bus failed: %d\n", error);
+		return error;
+	}
+	/* High-speed timing (at most 52 MHz: base / 8 is 25 MHz or 48 MHz here). */
+	if ((error = e_switch(185, 1))) {
+		printf("SWEET EMMC: HS timing switch failed: %d\n", error);
+		return error;
+	}
+	e_wr8(E_HOSTCTL, 0x24);
+	if ((error = e_status_ok())) {
+		printf("SWEET EMMC: HS timing failed: %d\n", error);
+		return error;
+	}
+	return 0;
+}
+
+/*
+ * Read count 512-byte sectors at lba into the bounce buffer with ADMA2 DMA
+ * (CMD18, auto CMD12). count <= BOUNCE_SIZE / 512.
+ */
+static int
+e_read_blocks(uint64_t lba, uint32_t count)
+{
+	volatile uint32_t *desc = (volatile uint32_t *)(se.dma + DMA_ADMA);
+	uint64_t bounce_pa = se.dma_pa + DMA_BOUNCE;
+	uint32_t bytes = count * EBLOCK, n, i;
+	int error;
+
+	if (count == 0 || count > BOUNCE_SIZE / EBLOCK || lba > UINT32_MAX) {
+		return EINVAL;
+	}
+	n = (bytes + ADMA_CHUNK - 1) / ADMA_CHUNK;
+	for (i = 0; i < n; i++) {
+		uint32_t chunk = MIN(ADMA_CHUNK, bytes - i * ADMA_CHUNK);
+		/* [15:0] attributes: valid (1), end (2), transfer action (0x20); [31:16] length */
+		desc[2 * i] = (chunk << 16) | 0x21 | (i == n - 1 ? 0x2 : 0);
+		desc[2 * i + 1] = (uint32_t)(bounce_pa + (uint64_t)i * ADMA_CHUNK);
+	}
+	dma_sync(DMA_ADMA, 8 * n);
+	dma_sync(DMA_BOUNCE, bytes);
+	__builtin_arm_dsb(0xf);
+
+	error = e_wait_idle(PS_CMD_INH | PS_DAT_INH, 200 * MS_NS);
+	if (error) {
+		return error;
+	}
+	e_wr8(E_HOSTCTL, (e_rd8(E_HOSTCTL) & ~0x18) | 0x10);   /* DMA select: ADMA2, 32-bit */
+	e_wr32(E_ADMA_ADDR, (uint32_t)(se.dma_pa + DMA_ADMA));
+	e_wr32(E_ADMA_ADDR + 4, 0);
+	e_wr32(E_NINT, 0xffffffff);
+	e_wr32(E_BLK, (count << 16) | EBLOCK);
+	e_wr32(E_ARG, (uint32_t)lba);
+	/* transfer mode: DMA enable, block count enable, auto CMD12, read, multi-block */
+	e_wr32(E_CMDMODE, ((18u << 8) | CMDF_R1 | CMDF_DATA) << 16 | 0x0037);
+	error = e_wait_nint(NI_CMD_DONE, 300 * MS_NS);
+	if (!error) {
+		e_wr16(E_NINT, NI_CMD_DONE);
+		error = e_wait_nint(NI_XFER_DONE, 2000 * MS_NS);
+		if (!error) {
+			e_wr16(E_NINT, NI_XFER_DONE);
+		}
+	}
+	e_wr8(E_HOSTCTL, e_rd8(E_HOSTCTL) & ~0x18);
+	if (error) {
+		printf("SWEET EMMC: read of %u sectors at 0x%llx failed: %d (nint 0x%x eint 0x%x adma 0x%x)\n",
+		    count, lba, error, se.nint, se.eint, e_rd32(E_ADMA_ERR));
+		e_reset_lines();
+		(void)e_cmd(12, 0, CMDF_R1B);   /* leave the card's data state */
+		return error;
+	}
+	dma_sync(DMA_BOUNCE, bytes);
+	return 0;
+}
+
+static int
+e_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(se.dma + DMA_BOUNCE);
+	int error = e_read_blocks(1, 1);
+
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET EMMC: no GPT\n");
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET EMMC: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = e_read_blocks(entry_lba, (nent * esz + EBLOCK - 1) / EBLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		se.first_block = first;
+		se.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET EMMC: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static int
+sweet_emmc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!se.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sweet_emmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_emmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * se.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = se.nblocks * EBLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_emmc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / EBLOCK;
+		uint32_t skip = (uint32_t)(pos % EBLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + EBLOCK - 1) / EBLOCK;
+		error = e_read_blocks(se.first_block + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(se.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_emmc_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_emmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = se.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > 4096 || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		se.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = EBLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = se.nblocks * EBLOCK / se.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / se.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_emmc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_emmc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_emmc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_emmc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_emmc_psize(__unused dev_t dev)
+{
+	return se.ready ? (int)MIN(se.nblocks * EBLOCK / se.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_emmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_emmc_strategy, NULL, dev, B_READ, minphys, uio, (int)se.secsize);
+}
+
+static int
+sweet_emmc_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw sweet_emmc_bdevsw = {
+	.d_open     = sweet_emmc_open,
+	.d_close    = sweet_emmc_close,
+	.d_strategy = sweet_emmc_strategy,
+	.d_ioctl    = sweet_emmc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_emmc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_emmc_cdevsw = {
+	.d_open       = sweet_emmc_open,
+	.d_close      = sweet_emmc_close,
+	.d_read       = sweet_emmc_read,
+	.d_write      = sweet_emmc_write,
+	.d_ioctl      = sweet_emmc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_emmc_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-emmc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET EMMC: no /sweet-emmc node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("emmcroot", want, sizeof(want));
+
+	se.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &se.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET EMMC: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)se.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	se.dma_pa = ptoa_64(pn);
+	/* The ADMA2 descriptors used here carry 32-bit addresses. */
+	if ((se.dma_pa + DMA_SIZE - 1) >> 32) {
+		printf("SWEET EMMC: DMA memory at 0x%llx is above 4 GiB\n", se.dma_pa);
+		return ENOMEM;
+	}
+	se.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_emmc_lock);
+	error = e_bringup();
+	if (!error) {
+		error = e_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_emmc_lock);
+	if (error) {
+		return error;
+	}
+
+	se.bmajor = bdevsw_add(-1, &sweet_emmc_bdevsw);
+	if (se.bmajor < 0) {
+		return ENXIO;
+	}
+	se.cmajor = cdevsw_add_with_bdev(-1, &sweet_emmc_cdevsw, se.bmajor);
+	if (se.cmajor < 0) {
+		return ENXIO;
+	}
+	se.bdev = makedev(se.bmajor, 0);
+	devfs_make_node(se.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "emmcroot0");
+	devfs_make_node(makedev(se.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "remmcroot0");
+	se.ready = true;
+	printf("SWEET EMMC: \"%s\": first sector 0x%llx, %llu MiB, read-only, DMA at 0x%llx\n",
+	    want, se.first_block, se.nblocks * EBLOCK >> 20, se.dma_pa);
+	return 0;
+}
+
+/* Root device for rd=emmcroot0 (IOFindBSDRoot). */
+int sweet_emmc_rootdev(dev_t *dev);
+
+int
+sweet_emmc_rootdev(dev_t *dev)
+{
+	if (!se.ready) {
+		int error = sweet_emmc_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = se.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
